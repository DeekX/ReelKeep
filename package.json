{
  "name": "reelkeep",
  "version": "2.6.0",
  "description": "Local-first library for everything you want to keep: videos, articles, images, audio, PDFs, notes and files. Zero dependencies, no build step, plain JSON storage.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "build:ext": "node scripts/build-extension.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "keywords": [
    "video",
    "library",
    "gallery",
    "youtube",
    "vimeo",
    "thumbnails",
    "local-first",
    "zero-dependency",
    "vanilla-js",
    "json"
  ],
  "author": "DEEK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeekX/ReelKeep.git"
  },
  "homepage": "https://deekx.github.io/ReelKeep/",
  "bugs": {
    "url": "https://github.com/DeekX/ReelKeep/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
