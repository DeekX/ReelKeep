{
  "manifest_version": 3,
  "name": "ReelKeep",
  "version": "2.2.0",
  "description": "One-click save to your private ReelKeep library. No account, no telemetry, nothing leaves your device.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to ReelKeep",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
